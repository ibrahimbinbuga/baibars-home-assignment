{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "fleet-api",
    "Audience": "fleet-mobile",
    "LifetimeMinutes": 60
  },
  "Telemetry": {
    "OfflineThresholdSeconds": 30,
    "OfflineCheckIntervalSeconds": 5,
    "LowBatteryThresholdPct": 20,
    "MaxClockSkewSeconds": 300
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}

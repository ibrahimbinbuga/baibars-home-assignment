{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Simulator": {
    "ApiBaseUrl": "http://localhost:8080",
    "DevicesFile": "../../../config/devices.json",
    "IntervalSeconds": 2,
    "DropoutSerial": "SN-0004",
    "DropoutEverySeconds": 180,
    "DropoutDurationSeconds": 45
  }
}
